diff --git a/backend/scripts/migrate-final-evaluation-ratings.js b/backend/scripts/migrate-final-evaluation-ratings.js
new file mode 100644
--- /dev/null
+++ b/backend/scripts/migrate-final-evaluation-ratings.js
@@
+require('dotenv').config();
+const connectDB = require('../config/db');
+const FinalEvaluation = require('../models/FinalEvaluation');
+const { determineRatingLabel } = require('../services/scoreCalculationService');
+
+async function migrateFinalEvaluationRatings() {
+  await connectDB();
+  const evaluations = await FinalEvaluation.find({ final_score: { $ne: null } }).select('_id final_score rating_label');
+  let updated = 0;
+  for (const evaluation of evaluations) {
+    const rating = determineRatingLabel(evaluation.final_score);
+    if (evaluation.rating_label !== rating) {
+      evaluation.rating_label = rating;
+      await evaluation.save();
+      updated += 1;
+    }
+  }
+  console.log(`Updated ${updated} final evaluation rating label(s).`);
+  process.exit(0);
+}
+migrateFinalEvaluationRatings().catch((error) => {
+  console.error('Final evaluation rating migration failed:', error);
+  process.exit(1);
+});
