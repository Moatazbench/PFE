          <mxGeometry x="400" y="740" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="genAIBox" value="External generative-AI&#10;providers (LLM APIs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="740" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="errHandlerBox" value="errorHandler.js&#10;(centralized error middleware, last in chain)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="850" width="300" height="50" as="geometry" />
