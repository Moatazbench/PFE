        <mxCell id="mwArrow4" style="html=1;endArrow=block;startArrow=none;fontSize=10;" edge="1" parent="1" source="mw4" target="mw5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mwArrow5" style="html=1;endArrow=block;startArrow=none;fontSize=10;" edge="1" parent="1" source="mw5" target="mw6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mwArrow6" style="html=1;endArrow=block;startArrow=none;fontSize=10;" edge="1" parent="1" source="mw6" target="mw7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mwArrow7" style="html=1;endArrow=block;startArrow=none;fontSize=10;" edge="1" parent="1" source="mw7" target="mw8"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Route modules layer -->
        <mxCell id="routesBox" value="Route modules (26 mounted under /api, e.g. /api/objectives, /api/teams, /api/checkins, /api/final-evaluations, /api/ai, /api/bonus-penalty, ...)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;dashed=1;strokeColor=#999999;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="1020" height="100" as="geometry" />
        </mxCell>
        <mxCell id="routeMods" value="objectives.js  |  teams.js  |  cycles.js  |  checkins.js  |  tasks.js  |  evaluations.js  |  finalEvaluations.js  |  hrDecisions.js  |  bonusPenalty.js  |  feedback.js  |  meetings.js  |  calendar.js  |  career.js  |  ai.js  |  notifications.js  |  auditLog.js  |  pdf.js  |  reports.js  |  stats.js  |  users.js  |  auth.js  |  ..." style="text;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontSize=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="980" height="60" as="geometry" />
        </mxCell>

        <!-- Per-route auth/role/ownership layer -->
        <mxCell id="authLayer" value="Per-route access-control middleware (composed per route, not global)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;dashed=1;strokeColor=#999999;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="1020" height="110" as="geometry" />
        </mxCell>
        <mxCell id="al1" value="auth.js&#10;(verify JWT, attach req.user)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="70" y="400" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="al2" value="role.js&#10;(RBAC: ADMIN/HR/TEAM_LEADER/COLLABORATOR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="320" y="400" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="al3" value="ownership.js&#10;(resource-owner check)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="400" width="180" height="50" as="geometry" /></mxCell>
        <mxCell id="al4" value="validate.js&#10;(request schema validation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="400" width="180" height="50" as="geometry" /></mxCell>
        <mxCell id="alArrow1" style="html=1;endArrow=block;startArrow=none;fontSize=10;" edge="1" parent="1" source="al1" target="al2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="alArrow2" style="html=1;endArrow=block;startArrow=none;fontSize=10;" edge="1" parent="1" source="al2" target="al3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="alArrow3" style="html=1;endArrow=block;startArrow=none;fontSize=10;" edge="1" parent="1" source="al3" target="al4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Controller layer -->
        <mxCell id="ctrlBox" value="Controllers (15, one per domain area -- thin HTTP handlers)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;dashed=1;strokeColor=#999999;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="1020" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ctrlMods" value="objectiveController  |  teamController  |  cycleController  |  checkInController  |  taskController  |  evaluationController  |  finalEvaluationController  |  hrDecisionController  |  feedbackController  |  improvementPlanController  |  careerController  |  aiController  |  notificationController  |  statsController  |  userController" style="text;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontSize=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="980" height="50" as="geometry" />
        </mxCell>

        <!-- Services layer -->
        <mxCell id="svcBox" value="Services (business logic extracted from controllers)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;dashed=1;strokeColor=#999999;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="1020" height="90" as="geometry" />
        </mxCell>
        <mxCell id="svc1" value="scoreCalculationService&#10;(weighted final score)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="70" y="640" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="svc2" value="reviewContextService&#10;(evidence summary)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="320" y="640" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="svc3" value="aiService&#10;(generative-AI provider adapter)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="570" y="640" width="220" height="45" as="geometry" /></mxCell>

        <!-- Models + external -->
        <mxCell id="modelsBox" value="Mongoose Models (20)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
