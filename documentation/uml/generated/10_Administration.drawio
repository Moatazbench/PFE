        <mxCell id="uc1" value="Manage Cycles&#10;incl. phase configuration&#10;(POST/PUT /api/cycles)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="50" width="190" height="65" as="geometry" />
