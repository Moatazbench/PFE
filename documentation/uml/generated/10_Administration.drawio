        </mxCell>

        <mxCell id="note" value="Cycle creation and phase updates are Admin-only in the current implementation (role('ADMIN') on POST/PUT /api/cycles) even though HR is the process owner of the cycle conceptually; correction-request approval belongs to the Team Leader/Admin (see Ch5) and is not an Admin function -- both are reflected accurately here rather than as originally scoped." style="text;align=left;valign=top;whiteSpace=wrap;html=1;fontSize=9;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="180" y="230" width="600" height="35" as="geometry" />
        </mxCell>

