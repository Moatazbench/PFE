        <mxCell id="e1" style="html=1;endArrow=none;startArrow=none;" edge="1" parent="1" source="actAdmin" target="uc1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="html=1;endArrow=none;startArrow=none;" edge="1" parent="1" source="actAdmin" target="uc2">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="130"/></Array></mxGeometry>
