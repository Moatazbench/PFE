          <mxGeometry x="180" y="20" width="600" height="200" as="geometry" />
        </mxCell>

        <mxCell id="actAdmin" value="Admin" style="shape=umlActor;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1">
