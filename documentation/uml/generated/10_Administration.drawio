        <mxCell id="uc2" value="View Audit Log&#10;(GET /api/audit-logs)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="50" width="190" height="65" as="geometry" />
        </mxCell>
        <mxCell id="uc3" value="View Entity Audit Trail&#10;(GET /api/audit-logs/entity/:type/:id)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="150" width="220" height="65" as="geometry" />
