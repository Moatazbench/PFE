        <mxCell id="uc6" value="View All Feedback&#10;(Admin only)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="210" width="170" height="60" as="geometry" />
