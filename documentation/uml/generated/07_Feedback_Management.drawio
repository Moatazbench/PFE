<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram id="uc-feedback" name="Feedback Management">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="360" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="sys" value="360-Degree Feedback" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=13;dashed=1;strokeColor=#999999;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="180" y="10" width="600" height="300" as="geometry" />
        </mxCell>

        <mxCell id="actUser" value="User&#10;(any role)" style="shape=umlActor;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1">
