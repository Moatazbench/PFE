        <mxCell id="e4" style="html=1;endArrow=none;startArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="actUser" target="uc4">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="55" y="290"/><mxPoint x="525" y="290"/></Array></mxGeometry>
