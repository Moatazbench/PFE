          <mxGeometry x="750" y="120" width="30" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc1" value="Give Feedback&#10;(peer / manager)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="50" width="180" height="60" as="geometry" />
