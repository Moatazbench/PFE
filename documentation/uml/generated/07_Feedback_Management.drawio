        <mxCell id="e6" style="html=1;endArrow=none;startArrow=none;exitX=0.5;exitY=1;entryX=0.7;entryY=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="actAdmin" target="uc5">
