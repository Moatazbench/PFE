        <mxCell id="uc4" value="Set Feedback Visibility" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="130" width="170" height="60" as="geometry" />
