        <mxCell id="uc5" value="View Feedback Stats&#10;(team scope)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="210" width="180" height="60" as="geometry" />
