<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram id="authz-flow" name="Authorization Flow">
    <mxGraphModel dx="1200" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="s0" value="Incoming request&#10;Authorization: Bearer &lt;token&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="200" height="55" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="auth.js: header present&#10;and starts with &quot;Bearer &quot;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="255" y="100" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e401a" value="401 No token provided" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="115" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="no" style="html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="s1" target="e401a"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s2" value="jwt.verify(token, JWT_SECRET)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="255" y="200" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="yes" style="html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e401b" value="401 Token expired /&#10;Invalid token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="200" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="invalid / expired" style="html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="s2" target="e401b"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s3" value="Check in-memory auth-user&#10;cache (TTL 10s) for userId" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="245" y="300" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="valid" style="html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s4" value="User.findById(userId)&#10;.select('_id role isActive isDeleted').lean()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="470" y="305" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="cache miss" style="html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5b" value="cache write (10s TTL)" style="html=1;endArrow=block;fontSize=9;dashed=1;exitX=0.5;exitY=1;entryX=1;entryY=0.3;" edge="1" parent="1" source="s4" target="s3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="420"/><mxPoint x="455" y="420"/></Array></mxGeometry></mxCell>

        <mxCell id="s5" value="user found, isActive=true,&#10;isDeleted=false?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="245" y="420" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="cache hit" style="html=1;endArrow=block;fontSize=9;exitX=0;exitY=0.5;entryX=0,entryY=0.5;" edge="1" parent="1" source="s3" target="s5">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="380"/><mxPoint x="200" y="460"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e401c" value="401 User session&#10;invalid or unauthorized&#10;(cache cleared)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="420" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="no" style="html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="s5" target="e401c"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s6" value="req.user = { id, role, ...decoded }&#10;next()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="255" y="540" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="yes" style="html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s7" value="role.js(...allowedRoles):&#10;req.user.role === 'ADMIN'?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="245" y="630" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a9" style="html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s8" value="role in allowedRoles list?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="245" y="740" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a10" value="no (not admin)" style="html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e403a" value="403 Forbidden:&#10;insufficient permissions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="745" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a11" value="no" style="html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="s8" target="e403a"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s9" value="ownership.js(model): route&#10;requires ownership check?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="245" y="850" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a12" value="yes (admin) / yes (allowed)" style="html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="s7" target="s9">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="665"/><mxPoint x="130" y="885"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="a13" style="html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s10" value="req.user.role is&#10;ADMIN or HR?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="245" y="960" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a14" value="yes" style="html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s11" value="model.findById(id):&#10;doc.owner / doc.user / doc.manager&#10;== req.user.id ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="470" y="960" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a15" value="no" style="html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="s10" target="s11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e403b" value="403 Forbidden:&#10;not owner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="1080" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a16" value="no match" style="html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="s11" target="e403b"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s12" value="Controller executes&#10;(objectiveController, teamController, ...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="245" y="1080" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a17" value="yes (bypass)" style="html=1;endArrow=block;fontSize=9;exitX=0;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="s10" target="s12">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="995"/><mxPoint x="200" y="1100"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="a18" value="match" style="html=1;endArrow=block;fontSize=9;exitX=0.5;exitY=1;entryX=1;entryY=0.4;" edge="1" parent="1" source="s11" target="s12">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="1110"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="a19" value="no (public route)" style="html=1;endArrow=block;fontSize=9;exitX=1;exitY=0.5;entryX=1;entryY=0.2;" edge="1" parent="1" source="s9" target="s12">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="885"/><mxPoint x="740" y="1095"/></Array></mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
