  <diagram id="activity-checkin" name="Activity - Check-in Submission and Review">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="laneCollab" value="Collaborator" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;align=center;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="340" height="580" as="geometry" /></mxCell>
        <mxCell id="laneLeader" value="Team Leader" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;align=center;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="0" width="340" height="580" as="geometry" /></mxCell>
        <mxCell id="laneSystem" value="System" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;align=center;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="700" y="0" width="340" height="580" as="geometry" /></mxCell>

        <mxCell id="initial" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="175" y="50" width="30" height="30" as="geometry" /></mxCell>

        <mxCell id="n1" value="Update Objective Progress %" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="260" height="60" as="geometry" /></mxCell>
        <mxCell id="n2" value="Attach Evidence (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="260" height="60" as="geometry" /></mxCell>
        <mxCell id="n3" value="Submit Check-in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="260" height="60" as="geometry" /></mxCell>

        <mxCell id="n4" value="Set status = pending_review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="290" width="220" height="60" as="geometry" /></mxCell>

        <mxCell id="n5" value="Review Check-in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="290" width="260" height="60" as="geometry" /></mxCell>

        <mxCell id="d1" value="Decision?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="390" width="120" height="80" as="geometry" /></mxCell>

        <mxCell id="nApprove" value="status = approved;&#10;update objective.achievementPercent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="390" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="finalApprove" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="835" y="500" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="finalApproveRing" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="829" y="494" width="42" height="42" as="geometry" /></mxCell>

        <mxCell id="nRevisionReq" value="status = revision_requested" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="490" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="nRevise" value="Revise Check-in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="260" height="60" as="geometry" /></mxCell>

        <mxCell id="e1" style="html=1;endArrow=block;rounded=0;" edge="1" parent="1" source="initial" target="n1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="html=1;endArrow=block;rounded=0;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell>
