        <mxCell id="clsEvaluationOp" value="+ recordScore() / approve()" style="text;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clsEvaluation">
          <mxGeometry y="240" width="260" height="50" as="geometry" />
        </mxCell>

        <!-- ===== Relationships: short, direct, non-overlapping ===== -->

        <!-- Team leads User (vertical, adjacent) -->
        <mxCell id="rTeamUser1" style="html=1;endArrow=open;endFill=1;startArrow=none;fontSize=10;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="clsTeam" target="clsUser">
