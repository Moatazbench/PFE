<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram id="conceptual-class" name="Conceptual Class Diagram">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Team (top-left) -->
        <mxCell id="clsTeam" value="Team" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=1;resizeParent=1;resizeParentMax=0;collapsible=0;swimlaneFillColor=#ffffff;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="230" height="150" as="geometry" />
        </mxCell>
        <mxCell id="clsTeamAttr" value="- name : String&#10;- description : String&#10;- leader : User&#10;- members : User[]&#10;- parentTeam : Team" style="text;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clsTeam">
          <mxGeometry y="26" width="230" height="124" as="geometry" />
        </mxCell>

        <!-- User (below Team) -->
        <mxCell id="clsUser" value="User" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=1;resizeParent=1;resizeParentMax=0;collapsible=0;swimlaneFillColor=#ffffff;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="230" height="200" as="geometry" />
        </mxCell>
        <mxCell id="clsUserAttr" value="- name : String&#10;- email : String&#10;- password : String (hashed)&#10;- role : Role&#10;- team : Team&#10;- manager : User&#10;- isActive : Boolean" style="text;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clsUser">
          <mxGeometry y="26" width="230" height="124" as="geometry" />
        </mxCell>
        <mxCell id="clsUserOp" value="+ comparePassword(candidate)" style="text;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clsUser">
          <mxGeometry y="150" width="230" height="50" as="geometry" />
        </mxCell>

        <!-- Cycle (top-mid) -->
        <mxCell id="clsCycle" value="Cycle" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=1;resizeParent=1;resizeParentMax=0;collapsible=0;swimlaneFillColor=#ffffff;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="440" y="40" width="260" height="200" as="geometry" />
        </mxCell>
        <mxCell id="clsCycleAttr" value="- name : String&#10;- year : Number&#10;- status : CycleStatus&#10;- currentPhase : Phase&#10;- phase1Start/End : Date&#10;- phase2Start/End : Date&#10;- phase3Start/End : Date" style="text;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clsCycle">
          <mxGeometry y="26" width="260" height="124" as="geometry" />
        </mxCell>
        <mxCell id="clsCycleOp" value="+ validatePhaseSequence()" style="text;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clsCycle">
          <mxGeometry y="150" width="260" height="50" as="geometry" />
        </mxCell>

        <!-- Objective (top-right, wide) -->
        <mxCell id="clsObjective" value="Objective" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=1;resizeParent=1;resizeParentMax=0;collapsible=0;swimlaneFillColor=#ffffff;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="840" y="40" width="300" height="330" as="geometry" />
        </mxCell>
        <mxCell id="clsObjectiveAttr" value="- title : String&#10;- description : String&#10;- successIndicator : String&#10;- owner : User&#10;- cycle : Cycle&#10;- team : Team&#10;- category : IndividualTeam&#10;- weight : Number [1..100]&#10;- priority : Priority&#10;- achievementPercent : Number&#10;- weightedScore : Number&#10;- status : ObjectiveStatus&#10;- kpis : KPI[]&#10;- changeRequests : ChangeRequest[]" style="text;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clsObjective">
          <mxGeometry y="26" width="300" height="254" as="geometry" />
        </mxCell>
        <mxCell id="clsObjectiveOp" value="+ submit() / approve() / reject()&#10;+ requestRevision()" style="text;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clsObjective">
          <mxGeometry y="280" width="300" height="50" as="geometry" />
        </mxCell>

        <!-- Evaluation (far right) -->
        <mxCell id="clsEvaluation" value="Evaluation" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=1;resizeParent=1;resizeParentMax=0;collapsible=0;swimlaneFillColor=#ffffff;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1220" y="40" width="260" height="290" as="geometry" />
        </mxCell>
        <mxCell id="clsEvaluationAttr" value="- employeeId : User&#10;- evaluatorId : User&#10;- cycleId : Cycle&#10;- period : String&#10;- status : EvaluationStatus&#10;- objectiveAssessments : []&#10;- suggestedScore : Number&#10;- finalScore : Number&#10;- scoreHistory : ScoreHistory[]&#10;- approvals : Approval[]" style="text;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clsEvaluation">
          <mxGeometry y="26" width="260" height="214" as="geometry" />
