        <mxCell id="rTeamUser2" style="html=1;endArrow=open;endFill=1;startArrow=none;fontSize=10;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="clsTeam" target="clsUser">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rTeamUser2lbl" value="1 has members 0..*" style="text;html=1;fontSize=9;fontStyle=2;fontColor=#666666;align=center;" vertex="1" parent="1">
          <mxGeometry x="145" y="270" width="120" height="16" as="geometry" />
        </mxCell>

        <mxCell id="rTeamSelf" value="parent of" style="html=1;endArrow=open;endFill=1;startArrow=none;fontSize=9;fontStyle=2;fontColor=#666666;exitX=0;exitY=0.35;entryX=0;entryY=0.65;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="clsTeam" target="clsTeam">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-40" y="93"/><mxPoint x="-40" y="137"/></Array></mxGeometry>
        </mxCell>

        <!-- Team -> Cycle : receives (top row, adjacent) -->
        <mxCell id="rTeamCycle" value="0..* receives 1" style="html=1;endArrow=open;endFill=1;startArrow=none;fontSize=9;fontStyle=2;fontColor=#666666;exitX=1;exitY=0.15;entryX=0;entryY=0.15;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="clsTeam" target="clsCycle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- User -> Objective : owns -->
        <mxCell id="rUserObjective" value="1 owns 0..*" style="html=1;endArrow=open;endFill=1;startArrow=none;fontSize=9;fontStyle=2;fontColor=#666666;exitX=1;exitY=0.2;entryX=0;entryY=0.85;edgeStyle=orthogonalEdgeStyle;rounded=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="clsUser" target="clsObjective">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="380"/></Array></mxGeometry>
        </mxCell>

        <!-- Cycle -> Objective : contains (adjacent, top row) -->
        <mxCell id="rCycleObjective" value="1 contains 0..*" style="html=1;endArrow=open;endFill=1;startArrow=none;fontSize=9;fontStyle=2;fontColor=#666666;exitX=1;exitY=0.25;entryX=0;entryY=0.25;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="clsCycle" target="clsObjective">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Team -> Objective : scopes (lower route) -->
        <mxCell id="rTeamObjective" value="0..1 scopes 0..*" style="html=1;endArrow=open;endFill=1;startArrow=none;fontSize=9;fontStyle=2;fontColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.6;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="clsTeam" target="clsObjective">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="185"/><mxPoint x="380" y="240"/><mxPoint x="800" y="240"/></Array></mxGeometry>
        </mxCell>

        <!-- Objective -> Evaluation : assessed by (adjacent, top row) -->
        <mxCell id="rObjEval" value="0..* assessed by 0..1" style="html=1;endArrow=open;endFill=1;startArrow=none;fontSize=9;fontStyle=2;fontColor=#666666;exitX=1;exitY=0.2;entryX=0;entryY=0.2;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="clsObjective" target="clsEvaluation">
          <mxGeometry relative="1" as="geometry" />
