        <!-- Cycle -> Evaluation : scopes (upper route over Objective) -->
        <mxCell id="rCycleEval" value="1 scopes 0..*" style="html=1;endArrow=open;endFill=1;startArrow=none;fontSize=9;fontStyle=2;fontColor=#666666;exitX=1;exitY=0.08;entryX=0;entryY=0.08;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="clsCycle" target="clsEvaluation">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="52"/><mxPoint x="770" y="20"/><mxPoint x="1160" y="20"/><mxPoint x="1160" y="63"/></Array></mxGeometry>
        </mxCell>

        <!-- User -> Evaluation : is employee of (lower route under everything) -->
        <mxCell id="rUserEval" value="1 is evaluated in 0..*" style="html=1;endArrow=open;endFill=1;startArrow=none;fontSize=9;fontStyle=2;fontColor=#666666;exitX=1;exitY=0.6;entryX=0.15;entryY=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="clsUser" target="clsEvaluation">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="450"/><mxPoint x="330" y="600"/><mxPoint x="1259" y="600"/></Array></mxGeometry>
        </mxCell>

        <mxCell id="note1" value="Objective embeds KPI, ChangeRequest, Comment, ProgressUpdate, Attachment and ActivityLog as sub-documents (see the Document model diagrams in Chapters 5-6) -- omitted here for readability at the conceptual level." style="text;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fontSize=10;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="840" y="420" width="640" height="40" as="geometry" />
