<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram id="uc-auth" name="Auth and User Management">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="sys" value="Authentication &amp; User Management" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=13;dashed=1;strokeColor=#999999;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="660" height="420" as="geometry" />
        </mxCell>

        <mxCell id="actAny" value="Any User" style="shape=umlActor;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="actAdmin" value="Admin" style="shape=umlActor;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="300" width="30" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc1" value="Sign In&#10;(POST /api/auth/login)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="50" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="uc2" value="Refresh Access Token&#10;(POST /api/auth/refresh)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="130" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="uc3" value="Logout&#10;(POST /api/auth/logout)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="210" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="uc4" value="View / Update&#10;My Profile" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="290" width="170" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="html=1;endArrow=none;startArrow=none;" edge="1" parent="1" source="actAny" target="uc1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="html=1;endArrow=none;startArrow=none;" edge="1" parent="1" source="actAny" target="uc2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="html=1;endArrow=none;startArrow=none;" edge="1" parent="1" source="actAny" target="uc3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="html=1;endArrow=none;startArrow=none;" edge="1" parent="1" source="actAny" target="uc4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="uc5" value="Update User&#10;(name / email / team)&#10;(PUT /api/users/:id)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="50" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="uc6" value="Assign / Change&#10;User Role&#10;(PUT /api/users/:id)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="130" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="uc7" value="Deactivate User&#10;(soft delete)&#10;(DELETE /api/users/:id)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="210" width="180" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e5" style="html=1;endArrow=none;startArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="actAdmin" target="uc5">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="330"/><mxPoint x="150" y="77"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e6" style="html=1;endArrow=none;startArrow=none;" edge="1" parent="1" source="actAdmin" target="uc6">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="345"/><mxPoint x="170" y="157"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e7" style="html=1;endArrow=none;startArrow=none;" edge="1" parent="1" source="actAdmin" target="uc7">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="360"/><mxPoint x="190" y="237"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e8" value="&lt;&lt;include&gt;&gt;" style="html=1;endArrow=open;dashed=1;startArrow=none;fontSize=9;" edge="1" parent="1" source="uc5" target="uc1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="Every use case in this diagram requires a valid session -- Sign In is included implicitly by the auth.js middleware in front of every protected route." style="text;align=left;valign=top;whiteSpace=wrap;html=1;fontSize=10;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="480" y="300" width="380" height="45" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
