<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram id="uc-bonus-penalty" name="Bonus &amp; Penalty Management">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="boundary" value="Bonus &amp; Penalty Management" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=16;align=left;spacingLeft=14;spacingTop=10;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="300" y="30" width="780" height="680" as="geometry" />
        </mxCell>

        <!-- Actors -->
        <mxCell id="actorTL" value="Team Leader" style="shape=umlActor;whiteSpace=wrap;html=1;outlineConnect=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="70" height="90" as="geometry" />
        </mxCell>
        <mxCell id="actorHR" value="HR" style="shape=umlActor;whiteSpace=wrap;html=1;outlineConnect=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="70" height="90" as="geometry" />
        </mxCell>
        <mxCell id="actorAdmin" value="Admin" style="shape=umlActor;whiteSpace=wrap;html=1;outlineConnect=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="70" height="90" as="geometry" />
        </mxCell>

        <!-- Actor generalization: Admin bypasses every role check in role.js, so Admin inherits every use case reachable by Team Leader and HR -->
        <mxCell id="genTL" style="html=1;endArrow=block;endFill=0;dashed=0;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="actorAdmin" target="actorTL">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="genHR" style="html=1;endArrow=block;endFill=0;dashed=0;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="actorAdmin" target="actorHR">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Parent use case -->
        <mxCell id="ucManage" value="Manage Bonus &amp; Penalty&#10;Recommendations" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="110" width="230" height="90" as="geometry" />
        </mxCell>

        <!-- Children of Manage Bonus & Penalty Recommendations -->
        <mxCell id="ucRecordBonus" value="Record Bonus" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="660" y="60" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ucRecordPenalty" value="Record Penalty" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="660" y="140" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ucViewEligible" value="View Eligible&#10;Evaluations" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="660" y="220" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="cg1" style="html=1;endArrow=block;endFill=0;dashed=0;rounded=0;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="ucRecordBonus" target="ucManage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cg2" style="html=1;endArrow=block;endFill=0;dashed=0;rounded=0;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="ucRecordPenalty" target="ucManage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cg3" style="html=1;endArrow=block;endFill=0;dashed=0;rounded=0;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="ucViewEligible" target="ucManage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Standalone HR/Admin use cases -->
        <mxCell id="ucReview" value="Review Recommendation&#10;(Approve / Reject)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="360" y="380" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ucViewAll" value="View All Records" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="540" width="210" height="80" as="geometry" />
        </mxCell>

        <!-- Authenticate (shared, required by every top-level use case in this router via the auth middleware) -->
        <mxCell id="ucAuth" value="Authenticate" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1140" y="330" width="170" height="80" as="geometry" />
        </mxCell>

        <!-- Include relationships -->
        <mxCell id="inc1" value="&lt;&lt;include&gt;&gt;" style="html=1;endArrow=open;dashed=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="ucManage" target="ucAuth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc2" value="&lt;&lt;include&gt;&gt;" style="html=1;endArrow=open;dashed=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="ucReview" target="ucAuth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc3" value="&lt;&lt;include&gt;&gt;" style="html=1;endArrow=open;dashed=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="ucViewAll" target="ucAuth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Actor associations -->
        <mxCell id="e1" style="html=1;endArrow=none;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="actorTL" target="ucManage">
          <mxGeometry relative="1" as="geometry" />
