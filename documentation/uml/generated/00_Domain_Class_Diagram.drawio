        <mxCell id="clsUserAttr" value="- name : String&#10;- email : String (unique, @biat.com)&#10;- password : String (bcrypt hash, select:false)&#10;- role : Role {ADMIN, HR, TEAM_LEADER, COLLABORATOR}&#10;- team : Team&#10;- manager : User&#10;- isActive : Boolean&#10;- refreshToken : String (select:false)&#10;- isDeleted : Boolean" style="text;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="clsUser">
